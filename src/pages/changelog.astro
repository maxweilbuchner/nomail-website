---
import Base from "../layouts/Base.astro";
import raw from "../content/CHANGELOG.md?raw";
import { parseChangelog } from "../lib/render-changelog";
import { ALL_RELEASES } from "../config";

const sections = parseChangelog(raw);
const dateFormat = new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" });
const formatDate = (iso: string) => dateFormat.format(new Date(`${iso}T00:00:00Z`));
---

<Base
  title="NoMail Changelog — every release for macOS"
  description="Every NoMail release for macOS, newest first: the same notes the in-app updater shows."
>
  <div class="container page">
    <header class="page-head">
      <h1>Changelog</h1>
      <p>
        Every release, newest first: the same notes the in-app updater shows. Builds are
        on <a href={ALL_RELEASES}>GitHub</a>.
      </p>
    </header>

    {
      sections.map((s) => (
        <section class="release" id={`v${s.version}`}>
          <header class="release__head">
            <h2>
              {/* One line: Astro drops the whitespace node between elements
                  on separate lines, which would concatenate the words. */}
              <a href={`#v${s.version}`}><span class="release__brand">NoMail</span> {s.version}</a>
            </h2>
            <time datetime={s.date}>{formatDate(s.date)}</time>
          </header>
          <div class="prose" set:html={s.html} />
        </section>
      ))
    }
  </div>
</Base>

<style>
  .release {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-md) var(--gap-columns);
    padding-block: var(--space-xl);
    border-top: var(--rule-hair) solid var(--color-rule);
    scroll-margin-top: var(--space-3xl);
  }

  .release:first-of-type {
    border-top: 0;
  }

  /* The version and date ride along while their notes scroll past, parked
     just under the floating nav (12px offset + 60px bar + 24px air). */
  .release__head {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    align-self: start;
    position: sticky;
    top: calc(var(--space-sm) + 60px + var(--space-lg));
  }

  .release__head h2 {
    font-size: var(--text-title);
    line-height: 1.2;
  }

  .release__head a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .release__head a:hover {
    color: var(--color-accent);
  }

  /* The version stays the loud part; the name is there so the heading reads as
     "NoMail 0.7.8", which is what someone on a given release searches for. */
  .release__brand {
    color: var(--color-muted);
    font-weight: 500;
  }

  .release__head time {
    color: var(--color-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .release :global(.prose > :first-child) {
    margin-top: 0;
  }

  .release :global(h3) {
    margin-top: var(--space-lg);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
  }

  @media (max-width: 60rem) {
    .release {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Single column: the head sits above its notes, so it scrolls with them. */
    .release__head {
      position: static;
    }
  }
</style>
