---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/url";

// GitHub Pages serves this body (with a 404 status) for any unknown path.
const links = [
  { href: withBase("/"), label: "Home" },
  { href: withBase("/download/"), label: "Download" },
  { href: withBase("/changelog/"), label: "Changelog" },
  { href: withBase("/support/"), label: "Support" },
];
---

<Base
  title="Page not found — NoMail"
  description="That page doesn’t exist. Head back to NoMail, the local-first email client for macOS."
  noindex
>
  <div class="container narrow">
    <div class="notfound">
      <p class="notfound__code">404</p>
      <h1>This page doesn’t exist.</h1>
      <p class="notfound__lead">
        The link may be out of date, or the page may have moved. Everything the site has:
      </p>
      <nav class="notfound__links" aria-label="Site">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
  </div>
</Base>

<style>
  .narrow {
    max-width: 720px;
  }

  /* The shortest page on the site: without a floor the footer strands itself
     halfway up the viewport. */
  .notfound {
    margin-block: var(--space-8);
    min-height: 42vh;
  }

  .notfound__code {
    font-family: var(--nm-font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    color: var(--nm-fg-faint);
    margin: 0 0 var(--space-3);
  }

  .notfound__lead {
    color: var(--nm-fg-secondary);
    font-size: 1.0625rem;
    margin-block: var(--space-4) var(--space-5);
  }

  .notfound__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-5);
  }

  .notfound__links a {
    font-size: 0.9375rem;
    font-weight: 550;
  }
</style>
