---
import Base from "../layouts/Base.astro";
import { CONTACT_EMAIL, ISSUES_URL, MIN_MACOS, SPONSORS_CARD, SPONSORS_URL } from "../config";
import { withBase } from "../lib/url";
import { graph, organization, faqPage } from "../lib/schema";

const faq = [
  {
    q: "How do updates work?",
    a: `NoMail updates itself in-app: it checks for new releases on launch and every six hours, downloads in the background, and installs when you quit. What changed is always on the <a href="${withBase("/changelog/")}">changelog</a>.`,
  },
  {
    q: "Which email providers are supported?",
    a: "Gmail (personal and Google Workspace), Microsoft (Outlook.com and Hotmail), Fastmail and other JMAP servers, and iCloud or any generic IMAP server.",
  },
  {
    q: "Why is there no on-device AI on Intel Macs?",
    a: "The bundled local model ships as an Apple Silicon binary only. On Intel, everything else works, and you can still opt into an external AI provider with your own API key, or run without AI entirely.",
  },
  {
    q: "Where is my data stored?",
    a: `On your Mac, and nowhere else: mail lives in a local SQLite database, and NoMail has no backend your mail passes through. The <a href="${withBase("/privacy/")}">privacy policy</a> has the full picture.`,
  },
  {
    q: "Why can’t I sign in to Gmail, or why does Google show an “unverified app” warning?",
    a: "NoMail’s Google verification is still in progress. Until it completes, Google lets only accounts on NoMail’s tester list sign in with the built-in setup. They see an “unverified app” warning first and are asked to sign in again about once a week. Anyone else can connect Gmail by creating their own Google Cloud OAuth client; NoMail’s onboarding walks you through it. Either way, your mail goes only between your Mac and Google.",
  },
];

const schema = graph(organization(), faqPage(faq));
---

<Base
  title="NoMail Support — FAQ, providers, and contact"
  description="Help with NoMail, the macOS email client: how updates work, which providers are supported, where your mail is stored, and how to report a bug."
  schema={schema}
>
  <div class="container page">
    <header class="page-head">
      <h1>Support</h1>
      <p>
        Found a bug or missing something? <a href={ISSUES_URL}>Open an issue on GitHub</a>, or
        write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </header>

    <section>
      <h2 class="faq-head">Frequently asked questions</h2>
      <dl class="faq">
        {
          faq.map((item) => (
            <div class="faq__item">
              <dt>{item.q}</dt>
              <dd set:html={item.a} />
            </div>
          ))
        }
      </dl>
    </section>

    <section class="sponsor">
      <h2>Sponsor NoMail</h2>
      <div class="sponsor__body">
      <p>
        NoMail is free, and stays that way. Some of what keeps it running isn’t: Google
        requires an independent annual security assessment before any app may connect to
        Gmail, and code signing and notarization carry their own yearly costs. Sponsorship
        goes straight at those bills; no features move behind a paywall.
      </p>
      {
        SPONSORS_CARD ? (
          <iframe
            class="sponsor__card"
            src={`${SPONSORS_URL}/card`}
            title="Sponsor NoMail on GitHub"
            width="600"
            height="150"
            loading="lazy"
          />
        ) : (
          <p>
            <a href={SPONSORS_URL}>Sponsor NoMail on GitHub</a>
          </p>
        )
      }
      </div>
    </section>
  </div>
</Base>

<script>
  const card = document.querySelector<HTMLIFrameElement>(".sponsor__card");
  if (card) {
    window.addEventListener("blur", () => {
      setTimeout(() => card.classList.toggle("is-focused", document.activeElement === card));
    });
    window.addEventListener("focus", () => card.classList.remove("is-focused"));
  }
</script>

<style>
  .sponsor {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-lg) var(--gap-columns);
    margin-top: var(--section-gap-s);
    padding-top: var(--space-xl);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .sponsor h2,
  .faq-head {
    font-size: var(--text-title);
    line-height: 1.2;
  }

  .faq-head {
    margin-bottom: var(--space-lg);
  }

  .sponsor__body {
    display: grid;
    gap: var(--space-lg);
  }

  .sponsor p {
    color: var(--color-ink-2);
  }

  /* The card follows prefers-color-scheme itself (data-color-mode="auto"),
     so let the iframe canvas match whichever scheme it paints. */
  .sponsor__card {
    border: 0;
    max-width: 100%;
    color-scheme: light dark;
  }

  /* A focused cross-origin iframe matches neither :focus nor :focus-visible
     in the parent, so the script below marks it while it holds focus. */
  .sponsor__card.is-focused {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* The card content grows as the iframe narrows: the bio wraps, and below
     544px GitHub stacks the Sponsor button under the text. Heights measured
     against the live card (127px at full width, 228px at ~330px wide, 270px
     at ~272px). Re-measure if the sponsor bio changes. */
  @media (max-width: 600px) {
    .sponsor__card {
      height: 240px;
    }
  }

  @media (max-width: 380px) {
    .sponsor__card {
      height: 280px;
    }
  }

  @media (max-width: 60rem) {
    .sponsor {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
