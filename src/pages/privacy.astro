---
import Base from "../layouts/Base.astro";
import { Content as Privacy } from "../content/PRIVACY.md";
---

<Base
  title="NoMail Privacy Policy — no backend, no tracking"
  description="NoMail runs entirely on your Mac: no backend, no accounts system, no servers your mail passes through, and no analytics."
>
  <div class="container page">
    <article class="prose privacy">
      <Privacy />
    </article>
  </div>
</Base>

<style>
  .privacy :global(h1) {
    padding-bottom: var(--space-xl);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
</style>
