---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  /** A JSON-LD `@graph` document — build it with the helpers in lib/schema. */
  schema?: object;
  /** Keep the page out of the index (the 404 body, which has no URL of its own). */
  noindex?: boolean;
}

// The title tag is a search result, not a headline: it names the category and
// the platform, because "your inbox is a database" is nothing anyone types.
// The tagline still leads on the page itself, in the H1. Keep descriptions
// under ~155 characters — past that Google truncates the snippet.
const {
  title = "NoMail — a keyboard-first, local-first email client for Mac",
  description = "A keyboard-first, local-first email client for macOS. Custom views, a Markdown composer, and on-device AI that never sends your mail anywhere.",
  schema,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase("/og.png"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    {/* Google's favicon crawler and older browsers want a raster fallback. */}
    <link rel="icon" href={withBase("/icon.png")} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={withBase("/icon.png")} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NoMail" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* Declared so a scraper can lay out the large card before fetching it. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NoMail — a keyboard-first, local-first email client for macOS" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
