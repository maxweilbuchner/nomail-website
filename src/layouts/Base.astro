---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  /** A JSON-LD `@graph` document — build it with the helpers in lib/schema. */
  schema?: object;
}

// The title tag is a search result, not a headline: it names the category and
// the platform, because "your inbox is a database" is nothing anyone types.
// The tagline still leads on the page itself, in the H1. Keep descriptions
// under ~155 characters — past that Google truncates the snippet.
const {
  title = "NoMail — a keyboard-first, local-first email client for Mac",
  description = "A keyboard-first, local-first email client for macOS. Custom views, a Markdown composer, and on-device AI that never sends your mail anywhere.",
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase("/og.png"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
