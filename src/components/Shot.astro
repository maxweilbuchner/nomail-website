---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  /** Above-the-fold shots load eagerly with high fetch priority. */
  priority?: boolean;
  /** CSS width of the slot this shot fills, for picking a srcset candidate.
   *  Defaults to the full content column (the hero). */
  sizes?: string;
}

const { light, dark, alt, priority = false, sizes = "(max-width: 1120px) 100vw, 1040px" } =
  Astro.props;

// Shots are captured at 2720px wide for retina; without a width set every
// visitor downloads all of it, including a phone that can show a fifth of it.
// The ladder tops out at the source width — Astro never upscales.
const WIDTHS = [640, 1040, 1440, 2080, 2720];

const optimize = (src: ImageMetadata) => getImage({ src, format: "webp", widths: WIDTHS, sizes });

const l = await optimize(light);
const d = dark ? await optimize(dark) : null;
---

<figure class="shot">
  <picture>
    {
      d && (
        <source
          media="(prefers-color-scheme: dark)"
          srcset={d.srcSet.attribute}
          sizes={sizes}
          width={dark!.width}
          height={dark!.height}
        />
      )
    }
    <img
      src={l.src}
      srcset={l.srcSet.attribute}
      sizes={sizes}
      alt={alt}
      width={light.width}
      height={light.height}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
  </picture>
</figure>

<style>
  .shot {
    margin: 0;
    border: 1px solid var(--nm-border);
    border-radius: var(--nm-radius-lg);
    overflow: hidden;
    box-shadow: var(--shot-shadow);
    background: var(--nm-bg-card);
  }

  .shot img {
    width: 100%;
    height: auto;
  }
</style>
