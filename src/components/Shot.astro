---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  /** Above-the-fold shots load eagerly with high fetch priority. */
  priority?: boolean;
  /** CSS width the *whole image* renders at (a crop renders it wider than its
   *  frame), for picking a srcset candidate. Defaults to the full container. */
  sizes?: string;
  /** Show only part of the capture, as fractions of the image: x/y the top
   *  left corner, w/h the size. The frame takes the crop's aspect ratio, so a
   *  re-captured screenshot of the same window lands in the same place. */
  crop?: { x: number; y: number; w: number; h: number };
  /** Fill the frame's height instead of the crop's aspect ratio, anchored top. */
  fill?: boolean;
  class?: string;
}

const {
  light,
  dark,
  alt,
  priority = false,
  sizes = "(max-width: 1440px) 100vw, 1312px",
  crop,
  fill = false,
  class: className,
} = Astro.props;

// Shots are captured at 2720px wide for retina; without a width set every
// visitor downloads all of it, including a phone that can show a fifth of it.
// The ladder tops out at the source width — Astro never upscales.
const WIDTHS = [640, 1040, 1440, 2080, 2720];

const optimize = (src: ImageMetadata) => getImage({ src, format: "webp", widths: WIDTHS, sizes });

const l = await optimize(light);
const d = dark ? await optimize(dark) : null;

const c = crop ?? { x: 0, y: 0, w: 1, h: 1 };
const style = fill
  ? undefined
  : [
      `--ratio: ${(c.w * light.width) / (c.h * light.height)}`,
      `--zoom: ${1 / c.w}`,
      `--left: ${(-c.x / c.w) * 100}%`,
      `--top: ${(-c.y / c.h) * 100}%`,
    ].join("; ");
---

<figure class:list={["shot", fill && "shot--fill", className]} style={style} data-kind="product">
  <picture>
    {
      d && (
        <source
          media="(prefers-color-scheme: dark)"
          srcset={d.srcSet.attribute}
          sizes={sizes}
          width={dark!.width}
          height={dark!.height}
        />
      )
    }
    <img
      src={l.src}
      srcset={l.srcSet.attribute}
      sizes={sizes}
      alt={alt}
      width={light.width}
      height={light.height}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
  </picture>
</figure>

<style>
  .shot {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    border: var(--rule-hair) solid var(--color-rule-strong);
    border-radius: var(--radius-lg);
    background: var(--color-paper-3);
    box-shadow: var(--shadow-modal);
  }

  .shot img {
    position: absolute;
    left: var(--left);
    top: var(--top);
    width: calc(var(--zoom) * 100%);
    max-width: none;
    height: auto;
  }

  .shot--fill img {
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }
</style>
