---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  /** Above-the-fold shots load eagerly with high fetch priority. */
  priority?: boolean;
}

const { light, dark, alt, priority = false } = Astro.props;

// Shots are captured at 2x retina; serve as optimized webp.
const l = await getImage({ src: light, format: "webp" });
const d = dark ? await getImage({ src: dark, format: "webp" }) : null;
---

<figure class="shot">
  <picture>
    {d && <source media="(prefers-color-scheme: dark)" srcset={d.src} />}
    <img
      src={l.src}
      alt={alt}
      width={l.attributes.width}
      height={l.attributes.height}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
  </picture>
</figure>

<style>
  .shot {
    margin: 0;
    border: 1px solid var(--nm-border);
    border-radius: var(--nm-radius-lg);
    overflow: hidden;
    box-shadow: var(--shot-shadow);
    background: var(--nm-bg-card);
  }

  .shot img {
    width: 100%;
    height: auto;
  }
</style>
