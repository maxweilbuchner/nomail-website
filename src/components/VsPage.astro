---
/**
 * One comparison page (/vs/<app>/). The pages share their shape — at-a-glance
 * table, where NoMail differs, where the other app is the better pick, FAQ —
 * so the structure and the Gmail note live here once and each page passes only
 * its facts. Every claim about the other app is dated by `checked`; re-verify
 * them against the vendor's own pages before changing that date.
 */
import Base from "../layouts/Base.astro";
import rawChangelog from "../content/CHANGELOG.md?raw";
import { parseChangelog } from "../lib/render-changelog";
import { graph, organization, softwareApplication, faqPage } from "../lib/schema";
import { CONTACT_EMAIL, MIN_MACOS } from "../config";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description: string;
  /** The other app's name as it reads in a sentence. */
  other: string;
  /** Month and year the claims about the other app were last checked. */
  checked: string;
  /** Opening paragraph(s), HTML. */
  intro: string;
  rows: readonly { label: string; nomail: string; other: string }[];
  /** "Where NoMail is different" bullets, HTML. */
  differs: readonly string[];
  /** "Where <other> is the better choice" bullets, HTML. */
  better: readonly string[];
  faq: readonly { q: string; a: string }[];
}

const { title, description, other, checked, intro, rows, differs, better, faq } = Astro.props;
const latest = parseChangelog(rawChangelog)[0];
const schema = graph(
  organization(),
  softwareApplication(latest?.version, latest?.date),
  faqPage(faq),
);
---

<Base title={title} description={description} schema={schema}>
  <div class="container page">
    <article class="vs">
      <header class="page-head vs__head">
        <h1>NoMail vs {other}</h1>
        <div class="vs__intro" set:html={intro} />
      </header>

      <section class="vs__glance" aria-labelledby="vs-glance">
        <h2 id="vs-glance">At a glance</h2>
        <div class="vs__scroll">
          <table class="vs__table">
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">Topic</span></th>
                <th scope="col">NoMail</th>
                <th scope="col">{other}</th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td data-label="NoMail" set:html={row.nomail} />
                    <td data-label={other} set:html={row.other} />
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="vs__part prose">
        <h2>Where NoMail is different</h2>
        <ul>{differs.map((item) => <li set:html={item} />)}</ul>
      </section>

      <section class="vs__part prose">
        <h2>Where {other} is the better choice</h2>
        <ul>{better.map((item) => <li set:html={item} />)}</ul>
      </section>

      <section class="vs__part prose">
        <h2>A note on Gmail</h2>
        <p>
          NoMail’s Google verification is still in progress. Until it completes, Google lets only
          accounts on NoMail’s tester list sign in to Gmail with the built-in setup; anyone else
          needs to create their own Google Cloud OAuth client, which NoMail’s onboarding walks
          through. Outlook.com, iCloud, Fastmail and other IMAP or JMAP accounts are not affected.
        </p>
      </section>

      <section class="vs__part">
        <h2>Questions</h2>
        <div>
          <dl class="faq">
            {
              faq.map((item) => (
                <div class="faq__item">
                  <dt>{item.q}</dt>
                  <dd set:html={item.a} />
                </div>
              ))
            }
          </dl>
          <p class="vs__checked">
            What this page says about {other} was last checked in {checked}. Pricing and features
            change. If something here is out of date, tell us at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
          </p>
        </div>
      </section>

      <section class="vs__part vs__try">
        <h2>Try NoMail</h2>
        <div class="vs__try-body">
          <p>Free, for {MIN_MACOS} or later. It runs alongside whatever you use today.</p>
          <a class="btn btn--primary" href={withBase("/download/")}>Download NoMail</a>
        </div>
      </section>
    </article>
  </div>
</Base>

<style>
  .vs__intro :global(p) {
    font-size: var(--text-lead);
    line-height: 1.5;
    max-width: 60ch;
    color: var(--color-ink-2);
  }

  .vs__glance h2 {
    margin-bottom: var(--space-lg);
    font-size: var(--text-title);
    line-height: 1.2;
  }

  .vs__scroll {
    overflow-x: auto;
  }

  .vs__table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    text-align: left;
  }

  .vs__table th,
  .vs__table td {
    padding: var(--space-md) var(--space-lg) var(--space-md) 0;
    vertical-align: top;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .vs__table thead th {
    padding-block: var(--space-sm);
    border-bottom: var(--rule-hair) solid var(--color-rule);
    color: var(--color-ink);
    font-size: var(--text-title);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .vs__table thead th:first-child,
  .vs__table tbody th {
    width: 22%;
  }

  .vs__table tbody th {
    color: var(--color-ink);
    font-weight: 700;
  }

  .vs__table td {
    color: var(--color-ink-2);
  }

  .vs__part {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-md) var(--gap-columns);
    margin-top: var(--section-gap-s);
    padding-top: var(--space-xl);
    border-top: var(--rule-hair) solid var(--color-rule);
    max-width: none;
  }

  .vs__part h2 {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: var(--text-title);
    line-height: 1.2;
  }

  .vs__part > :global(ul),
  .vs__part > p {
    margin: 0;
  }

  .vs__part :global(.faq__item) {
    grid-template-columns: minmax(0, 1fr);
  }

  .vs__part :global(.faq__item:first-child) {
    border-top: 0;
    padding-top: 0;
  }

  .vs__checked {
    margin-top: var(--space-lg);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .vs__try-body {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  @media (max-width: 60rem) {
    .vs__part {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .vs__table {
      min-width: 0;
    }

    .vs__table thead {
      display: none;
    }

    .vs__table tr,
    .vs__table th,
    .vs__table td,
    .vs__table tbody th {
      display: block;
      width: auto;
    }

    .vs__table tr {
      padding-block: var(--space-md);
      border-bottom: var(--rule-hair) solid var(--color-rule);
    }

    .vs__table tbody th,
    .vs__table td {
      padding: var(--space-2xs) 0;
      border: 0;
    }

    .vs__table td::before {
      content: attr(data-label) ": ";
      color: var(--color-muted);
    }
  }
</style>
